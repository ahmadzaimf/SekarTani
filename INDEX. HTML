        // --- STATIC SLIDER NAVIGATION FOR INITIAL CARDS ---
        function geserSliderStatic(cardId, arah) {
            const wrapper = document.getElementById('slider-wrapper-' + cardId);
            let current = parseInt(wrapper.getAttribute('data-current') || 0);
            let max = parseInt(wrapper.getAttribute('data-max') || 0);

            current += arah;
            if(current < 0) current = max;
            if(current > max) current = 0;

            wrapper.setAttribute('data-current', current);
            wrapper.style.transform = `translateX(-${current * 100}%)`;
        }

        // --- SISTEM LOGIN & UTILITY ADMIN ---
        function bukaModalLogin() {
            if(statusAdminLoggedIn) {
                statusAdminLoggedIn = false;
                document.getElementById('adminPanel').style.display = 'none';
                document.getElementById('gateText').innerText = "Akses Sistem";
                alert("Anda telah aman keluar dari Sistem Log Admin.");
                toggleAksiHapusCard(false);
            } else {
                document.getElementById('loginModal').style.display = 'flex';
            }
        }

        function tutupModalLogin() {
            document.getElementById('loginModal').style.display = 'none';
            document.getElementById('username').value = "";
            document.getElementById('password').value = "";
        }

        function prosesLoginAdmin() {
            const userIn = document.getElementById('username').value;
            const passIn = document.getElementById('password').value;

            if (userIn === adminUsernameSistem && passIn === adminPasswordSistem) {
                statusAdminLoggedIn = true;
                alert("Verifikasi Berhasil! Seluruh menu kendali elite kini terbuka.");
                tutupModalLogin();
                
                document.getElementById('adminPanel').style.display = 'block';
                document.getElementById('gateText').innerText = "Keluar Admin (X)";
                
                toggleAksiHapusCard(true);
                document.getElementById('adminPanel').scrollIntoView({ behavior: 'smooth' });
            } else {
                alert("Akses Ditolak! Username atau password salah.");
            }
        }

        function simpanKredensialBaru() {
            const userBaru = document.getElementById('inputNewUsername').value;
            const passBaru = document.getElementById('inputNewPassword').value;

            if(userBaru.trim() === "" || passBaru.trim() === "") {
                alert("Kredensial baru tidak boleh kosong!");
                return;
            }

            adminUsernameSistem = userBaru;
            adminPasswordSistem = passBaru;
            alert("Sukses! Kredensial login admin baru berhasil disimpan ke sistem.");
        }

        function updateIdentitasWebsite() {
            const judulDindingBaru = document.getElementById('inputJudulDinding').value;
            const namaWebBaru = document.getElementById('inputNamaWeb').value;
            const namaCreatorBaru = document.getElementById('inputNamaCreator').value;

            if(judulDindingBaru.trim() === "" || namaWebBaru.trim() === "" || namaCreatorBaru.trim() === "") {
                alert("Input tidak boleh ada yang kosong!");
                return;
            }

            document.getElementById('heroTitleDisplay').innerText = judulDindingBaru;
            document.getElementById('siteTitleTag').innerText = namaWebBaru + " - Premium Agriculture Market & Logistics";
