            document.getElementById('footerSiteName').innerText = namaWebBaru;
            document.getElementById('footerCreatorName').innerText = namaCreatorBaru;

            alert("Seluruh konfigurasi Judul Dinding & Identitas sukses diperbarui!");
        }

        // --- MANAGEMENT KATEGORI BEBAS (DINAMIS) ---
        function renderKategoriKeSistem() {
            const wrapperList = document.getElementById('wrapperDaftarKategori');
            const dropdownSelect = document.getElementById('kategori');

            wrapperList.innerHTML = "";
            daftarKategoriGlobal.forEach((kat, indeks) => {
                wrapperList.innerHTML += `
                    <div class="category-item">
                        ${kat} <span onclick="hapusKategoriBebas(${indeks})">X</span>
                    </div>
                `;
            });

            dropdownSelect.innerHTML = "";
            daftarKategoriGlobal.forEach(kat => {
                dropdownSelect.innerHTML += `<option value="${kat}">${kat}</option>`;
            });
        }

        function tambahKategoriBebas() {
            const nilaiInput = document.getElementById('inputKategoriBaru').value;
            if(nilaiInput.trim() === "") {
                alert("Ketikkan nama kategori terlebih dahulu!");
                return;
            }

            daftarKategoriGlobal.push(nilaiInput.trim());
            document.getElementById('inputKategoriBaru').value = "";
            renderKategoriKeSistem();
            alert("Kategori baru berhasil ditambahkan!");
        }

        function htmlEscape(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function hapusKategoriBebas(indeks) {
            if(daftarKategoriGlobal.length <= 1) {
                alert("Harus menyisakan minimal 1 kategori dalam sistem!");
                return;
            }
            if(confirm(`Hapus kategori "${daftarKategoriGlobal[indeks]}" dari sistem?`)) {
                daftarKategoriGlobal.splice(indeks, 1);
                renderKategoriKeSistem();
            }
        }

        // --- MANAJEMEN MULTI-UPLOAD FOTO KEGIATAN ---
        function previewMultiImages(input) {
            const container = document.getElementById('multiPreviewContainer');
            container.innerHTML = ""; 
            arrayBase64Foto = []; 

            if (input.files && input.files.length > 0) {
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        arrayBase64Foto.push(e.target.result);
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.classList.add('multi-preview-item');
                        container.appendChild(img);
                    }
                    reader.readAsDataURL(file);
                });
            }
        }

        function toggleAksiHapusCard(show) {
            const actions = document.querySelectorAll('.admin-actions');
            actions.forEach(item => {
                item.style.display = show ? 'block' : 'none';
            });
        }

        // --- SISTEM TAMBAH KEGIATAN DENGAN EXPLORER DETAIL ---
        function adminTambahKegiatan(event) {
            event.preventDefault();
            const judul = document.getElementById('judul').value;
            const kategori = document.getElementById('kategori').value;
            const petani = document.getElementById('petani').value;
            const deskripsi = document.getElementById('deskripsi').value;
            
            if(arrayBase64Foto.length === 0) {
                alert("Silakan unggah setidaknya 1 foto kegiatan!");
                return;
            }

            const uniqueId = 'card-' + counterId;
            
            // Simpan data lengkap ke database lokal agar bisa dipanggil saat diklik
            databaseLaporanLengkap[uniqueId] = {
                kategori: kategori,
                judul: judul,
                meta: `Oleh: ${petani} • Baru Saja`,
                deskripsi: deskripsi,
                foto: [...arrayBase64Foto]
            };

            let imagesHtml = "";
            arrayBase64Foto.forEach(base64Src => {
                imagesHtml += `<img src="${base64Src}">`;
            });

            let sliderControlsHtml = "";
            if (arrayBase64Foto.length > 1) {
                sliderControlsHtml = `
                    <button class="slider-btn prev" onclick="event.stopPropagation(); geserSlider('${uniqueId}', -1)">&#10094;</button>
                    <button class="slider-btn next" onclick="event.stopPropagation(); geserSlider('${uniqueId}', 1)">&#10095;</button>
                `;
            }

            const cardTemplate = `
                <div class="card" id="${uniqueId}" data-current-index="0" data-max-index="${arrayBase64Foto.length - 1}">
                    <div class="card-clickable-area" onclick="bukaDetailBerita('${uniqueId}')">
                        <div class="slider-container" onclick="event.stopPropagation();">
                            ${sliderControlsHtml}
                            <div class="slider-wrapper" id="wrapper-${uniqueId}">
                                ${imagesHtml}
                            </div>
                        </div>
                        <div class="card-content">
                            <span class="card-tag">${htmlEscape(kategori)}</span>
                            <h3 class="card-title">${htmlEscape(judul)}</h3>
                            <p class="card-meta">Oleh: ${htmlEscape(petani)} • Baru Saja</p>
                            <p class="card-description">${htmlEscape(deskripsi)}</p>
                            <div class="read-more-indicator">Lihat Penjelasan Lengkap &rarr;</div>
                        </div>
                    </div>
                    <div class="admin-actions" style="display: block;">
                        <button class="btn-delete" onclick="hapusKegiatan('${uniqueId}')">Hapus Postingan</button>
                    </div>
                </div>
            `;

            document.getElementById('wadahKegiatan').insertAdjacentHTML('afterbegin', cardTemplate);
            
            document.getElementById('formKegiatan').reset();
            document.getElementById('multiPreviewContainer').innerHTML = "";
            arrayBase64Foto = [];
            counterId++;
            alert('Sukses mempublikasikan laporan kegiatan baru dengan penjelasan lengkap!');
        }

        function geserSlider(cardId, arah) {
            const cardEl = document.getElementById(cardId);
            const wrapper = document.getElementById('wrapper-' + cardId);
            
            let currentIndex = parseInt(cardEl.getAttribute('data-current-index'));
            const maxIndex = parseInt(cardEl.getAttribute('data-max-index'));

            currentIndex += arah;

            if (currentIndex < 0) {
                currentIndex = maxIndex;
            } else if (currentIndex > maxIndex) {
                currentIndex = 0;
            }

            cardEl.setAttribute('data-current-index', currentIndex);
            wrapper.style.transform = `translateX(-${currentIndex * 100}%)`;
        }

        function hapusKegiatan(idCard) {
            if(confirm("Hapus arsip ini dari publik?")) {
                document.getElementById(idCard).remove();
                delete databaseLaporanLengkap[idCard];
            }
        }

        // Fluktuasi indeks bursa harga berkala (Tiap 4 detik)
        setInterval(() => {
            const gabahGkgRandom = 7700 + Math.floor(Math.random() * 300);
            const gabahGkpRandom = 6450 + Math.floor(Math.random() * 300);
            if(document.getElementById('price-gabah-gkg')) {
                document.getElementById('price-gabah-gkg').innerText = "Rp " + gabahGkgRandom.toLocaleString('id-ID');
                document.getElementById('price-gabah-gkp').innerText = "Rp " + gabahGkpRandom.toLocaleString('id-ID');
            }

            const jagungKeringRandom = 5800 + Math.floor(Math.random() * 300);
            const jagungManisRandom = 8000 + Math.floor(Math.random() * 400);
            if(document.getElementById('price-jagung-kering')) {
                document.getElementById('price-jagung-kering').innerText = "Rp " + jagungKeringRandom.toLocaleString('id-ID');
                document.getElementById('price-jagung-manis').innerText = "Rp " + jagungManisRandom.toLocaleString('id-ID');
            }

            const ureaNonRandom = 531000 + Math.floor(Math.random() * 9000);
            if(document.getElementById('fertilizer-urea-non')) {
                document.getElementById('fertilizer-urea-non').innerText = "Rp " + ureaNonRandom.toLocaleString('id-ID');
            }
        }, 4000);
    </script>
</body>
</html>
